# Upstream's in-tree libFuzzer harness Tests/Fuzzing/cmFortranParserFuzzer.cxx: the Fortran dependency scanner (lexer + parser).
# Built by mayhem/build.sh against the sanitized, coverage-instrumented CMakeLib.
# Run-once reproducer for the same code: /mayhem/cmFortranParserFuzzer-standalone <input file>.
project: savantenvs/cmake
target: cmFortranParserFuzzer
cmds:
  - cmd: /mayhem/cmFortranParserFuzzer
    libfuzzer: true
    dictionary: /mayhem/Tests/Fuzzing/cmFortranParser.dict
testsuite:
  - https://$MAYHEM_DOMAIN/$MAYHEM_PROJECT/$MAYHEM_TARGET/testsuite.tar
  - file://mayhem/cmFortranParserFuzzer/testsuite
